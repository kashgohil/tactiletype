# Netlify response headers. Static files in `public/` are served before the SPA
# fallback, so this file applies to every response including `/index.html`.
# HSTS is already set by Netlify's domain settings — don't duplicate it here.

/*
  # Stops browsers from second-guessing our Content-Type. Without it, a file we
  # serve as text/plain can be sniffed and executed as script.
  X-Content-Type-Options: nosniff

  # No reason for this app to be framed; blocks clickjacking outright.
  X-Frame-Options: DENY

  # Send the full URL to our own origin, bare origin cross-site, nothing on a
  # downgrade to HTTP. Keeps referral data useful without leaking paths.
  Referrer-Policy: strict-origin-when-cross-origin

  # The app asks for none of these. Denying them up front means a future
  # dependency can't quietly start asking.
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()

  # Isolates this origin's browsing-context group from popups it opens.
  Cross-Origin-Opener-Policy: same-origin

  # REPORT-ONLY until verified against a deploy preview. The browser logs
  # violations to the console and blocks nothing, so a wrong rule here cannot
  # take the site down.
  #
  # connect-src covers fetch, XHR, and WebSockets. api.trytactiletype.com is
  # listed under both https and wss because they are separate origins to CSP.
  # Confirm VITE_API_URL / VITE_WS_URL in Netlify still point there before
  # enforcing — those are set at build time and this static file cannot read them.
  #
  # To enforce: deploy a preview, exercise login, a typing test, and a
  # multiplayer room with the console open, confirm no CSP violations are
  # reported, then rename this header to Content-Security-Policy.
  #
  # 'unsafe-inline' in style-src is required: React writes inline style
  # attributes, and ThemeProvider sets custom properties on documentElement.
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.trytactiletype.com wss://api.trytactiletype.com; upgrade-insecure-requests

# Content-hashed build output is immutable — cache it hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts are versioned by filename and effectively never change.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Crawl-control files must never be served stale after an edit.
/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600
