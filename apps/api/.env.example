# Copy to .env and fill in values: cp apps/api/.env.example apps/api/.env
DATABASE_URL=postgresql://localhost:5432/tactile
JWT_SECRET=change-me-to-a-long-random-string
PORT=3021
NODE_ENV=development
# Exact-match CORS origin, and where OAuth sends the browser back to.
FRONTEND_URL=http://localhost:3020
# Base the OAuth callback URLs are built from. In production this is the API's
# own origin (https://api.trytactiletype.com), not the site's.
BASE_URL=http://localhost:3021

# Leave unset locally: cookies ignore port, so a host-only `localhost` cookie is
# already shared between Vite on :3020 and the API on :3021.
#
# REQUIRED in production, where the site and the API sit on different
# subdomains. Without it the CSRF cookie is host-only on the API subdomain and
# the site can never read it, so every write costs an extra /auth/csrf round
# trip and concurrent writes race to re-mint the token.
# COOKIE_DOMAIN=.trytactiletype.com

# Optional - Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional - GitHub OAuth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
